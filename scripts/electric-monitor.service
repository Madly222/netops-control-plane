[Unit]
Description=Electric Disconnection Monitor
After=network.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/home/user/netops-control-plane
Environment="PATH=/home/user/netops-control-plane/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/user/netops-control-plane/venv/bin/python /home/user/netops-control-plane/scripts/check_electric.py

[Install]
WantedBy=multi-user.target
