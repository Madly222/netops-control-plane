# ==============================================================================
#  .env  —  BUSINESS-AUTOMATION SECRETS (second config layer)
# ==============================================================================
# Copy this file to `.env` in the project root and fill in real values:
#     cp .env.example .env
#     nano .env
#
# WHY A SEPARATE FILE?
#   secrets.yaml   -> infrastructure (monitored servers, SSH, Claude, web users)
#   .env           -> business automation (billing DB, SMTP, FTP, NetBox, scrapers)
#
# WARNING: never commit the real .env (already in .gitignore).
# All values below are PLACEHOLDERS.
#
# Legend:  (required) must be set for the feature to work
#          (optional) has a code default; may be omitted
#          (unused)   present for historical reasons, NOT read by current code
# ==============================================================================


# ------------------------------------------------------------------------------
# WATER OUTAGE MONITOR  (acc_monitor / water provider)
# ------------------------------------------------------------------------------
ACC_ADDRESS_PATTERN=Street\s*,?\s*00\b        # (required) regex matched on water provider
ACC_CHECK_INTERVAL=3600                        # (optional) default 3600
ACC_EMAIL_ENABLED=true
ACC_SMTP_SERVER=mail.example.com
ACC_SMTP_PORT=25
ACC_SMTP_USER=control@example.com
ACC_SMTP_PASSWORD=
ACC_SMTP_TLS=true
ACC_EMAIL_FROM=control@example.com
ACC_EMAIL_TO=admin@example.com                  # comma-separated for multiple


# ------------------------------------------------------------------------------
# ELECTRICITY OUTAGE MONITOR  (electric_monitor / the power provider)
# Watched addresses: config/electric_addresses.txt
# All keys are OPTIONAL — if omitted, the code falls back to the ACC_* values above.
# ------------------------------------------------------------------------------
ELECTRIC_CHECK_INTERVAL=3600                   # (optional)
ELECTRIC_EMAIL_ENABLED=true                    # (optional)
ELECTRIC_SMTP_SERVER=                          # (optional) falls back to ACC_SMTP_SERVER
ELECTRIC_SMTP_PORT=                            # (optional) falls back to ACC_SMTP_PORT
ELECTRIC_EMAIL_FROM=                           # (optional) falls back to ACC_EMAIL_FROM
ELECTRIC_EMAIL_TO=                             # (optional) falls back to ACC_EMAIL_TO


# ==============================================================================
#  INVOICING  —  ⚠️ TEMPORARY FEATURE, SCHEDULED FOR REMOVAL
#  (invoice_generator / postal_generator / email_invoice_sender)
#  Do not build new functionality on these keys.
# ==============================================================================

# --- Billing server SSH (PayGate + Postal) -------------------------------------
INVOICE_SSH_HOST=172.0.0.0
INVOICE_SSH_USER=root
INVOICE_SSH_PASSWORD=
INVOICE_SSH_PORT=22                            # (optional) default 22
INVOICE_SSH_SCRIPT_DIR=/home/user
INVOICE_SSH_SCRIPT_CMD=sudo php index.php

# --- Invoice email delivery --------------------------------------------------
# Recipient list per client: config/invoice_clients_email.txt
INVOICE_EMAIL_FROM=control@example.com
INVOICE_EMAIL_TO=
INVOICE_EMAIL_CC=
INVOICE_TEST_MODE=false                        # true = send only to test address
INVOICE_TEST_EMAIL=admin@example.com

# email_invoice_sender.py overrides (optional)
EMAIL_INVOICE_TEST_MODE=false
EMAIL_INVOICE_TEST_EMAIL=admin@example.com      # (optional)
EMAIL_INVOICE_CC=
EMAIL_INVOICE_MERGE=true                       # merge multiple invoices into one PDF

# --- postal operator FTP upload (postal_generator) -----------------------------
# Client list: config/postal_clients.txt
INVOICE_FTP_HOST=ftp.example.com
INVOICE_FTP_USER=
INVOICE_FTP_PASSWORD=
INVOICE_FTP_PATH=/In/

# --- Billing database (MySQL, queried via mysql CLI over SSH) -----------------
BILLING_DB_NAME=billing
BILLING_DB_USER=billing
BILLING_DB_PASSWORD=


# ------------------------------------------------------------------------------
# DHCP -> NETBOX MAC SYNC  (dhcp_mac_sync)
# ------------------------------------------------------------------------------
NETBOX_URL=http://172.0.0.0/
NETBOX_TOKEN=

DHCP_SSH_HOST=
DHCP_SSH_USER=
DHCP_SSH_PASS=
DHCP_SSH_PORT=22

DHCP_MYSQL_USER=
DHCP_MYSQL_PASS=
DHCP_MYSQL_DB=


# ------------------------------------------------------------------------------
# CISCO / NETBOX AUTO-FILL  (services/netbox-autofill/)
# ------------------------------------------------------------------------------
SSH_USERNAME=                                  # (required) used by ssh_connector.py + Cisco MAC scan
SSH_PASSWORD=                                  # (required)

# ------------------------------------------------------------------------------
# MAC -> LEAF PORT SYNC  (src/monitoring/mac_port_sync.py, "Sync Ports" button)
# ------------------------------------------------------------------------------
TPLINK_SSH_USERNAME=                           # optional; defaults to SSH_USERNAME
TPLINK_SSH_PASSWORD=                           # optional; defaults to SSH_PASSWORD
MAC_LEAF_THRESHOLD=3                           # max MACs on a port to treat it as a client (leaf) port
MAC_CREATE_MISSING_IFACE=false                 # true = auto-create the leaf interface (e.g. gpon-onu) if absent
MAC_SCAN_DEVICES_FILE=                          # optional path to fallback inventory (default: config/scan_devices.txt)
MAC_MGMT_PREFIX=198.51.100.0/24                    # management subnet: scan every NetBox device with an IP here (not just primary)
MAC_OLT_MAX_PORT=16                             # highest GPON port to query per OLT (paging-safe MAC fetch)
MAC_OLT_SSH_TIMEOUT=30                          # per-command expect timeout for OLT MAC fetch (seconds)


# ==============================================================================
#  LEGACY / NOT READ BY CURRENT CODE
# ==============================================================================
# These keys may exist in older .env files but the current codebase does NOT
# read them. Kept here only so existing .env files map cleanly. Safe to remove.
#
#   BILLING_DB_HOST  -> unused: the billing DB is queried via mysql CLI over the
#                       SSH session to INVOICE_SSH_HOST, so no DB host is needed.
#   SSH_KEX          -> unused: netmiko handles legacy Cisco ciphers internally
#   SSH_CIPHERS      -> unused
#   SSH_HOST_KEY_ALGOS -> unused
#   SSH_MACS         -> unused
# ------------------------------------------------------------------------------
# BILLING_DB_HOST=
# SSH_KEX=
# SSH_CIPHERS=
# SSH_HOST_KEY_ALGOS=
# SSH_MACS=
